# Copy to .env and fill. .env is gitignored — never commit secrets.

# --- LLM (OpenRouter free tier only; paid model ids fail config validation at boot) ---
OPENROUTER_API_KEY=sk-or-...            # from vault / openrouter.ai keys
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
LLM_TIMEOUT_S=12
LLM_MAX_RETRIES=1

# --- App ---
DEMO_MODE=true                          # synthetic patients only
GOLDEN_CASES_CACHE=true                 # 3 golden cases cached client-side
RULES_FILE=./rules.json                 # ДСМ-174/2020 + №75 + PRIME catalog; engine reads, code holds no medical logic

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Contact center (booking handoff) ---
CONTACT_CENTER_PHONE=+77470942621
CONTACT_CENTER_EMAIL=salem@primegc.kz
